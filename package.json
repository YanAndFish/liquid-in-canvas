{
  "name": "liquid-in-canvas-workspace",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @liquid-in-canvas/demo dev",
    "build": "pnpm -r build",
    "build:lib": "pnpm --filter liquid-in-canvas build",
    "preview": "pnpm --filter @liquid-in-canvas/demo preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@unocss/eslint-plugin": "^66.12.0",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3"
  }
}
